# Public site — planned URL only; this preview is not a live store
NEXT_PUBLIC_SITE_URL=https://happypharmacy.pk
# Leave empty until a WhatsApp number is confirmed
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Analytics — leave empty until pixels are approved
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Local Docker Compose Postgres only (docker-compose.yml, port 5433).
# Never point this at a production database.
DATABASE_URL="postgresql://happy_dev:happy_dev_local@127.0.0.1:5433/happy_pharmacy_dev?schema=public"

# Public Cloudinary cloud name only. Used by next/image remotePatterns.
# Never put API keys, API secrets, or upload presets that grant write access here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Homepage-only preview of DRAFT client baby-care photographs.
# This does not change ProductVisibility and must never be set in production.
# When false or unset, draft products do not appear anywhere on public pages.
SHOW_DRAFT_HOMEPAGE_SHOWCASE=false